# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings -> API). O anon key é uma chave pública, segura para expor no frontend —
# o acesso real aos dados é controlado pelas políticas de Row Level Security do banco.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI
