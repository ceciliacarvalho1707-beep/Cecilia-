rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada conversa fica em salas/<código da senha>/msgs.
    // Só quem sabe a senha chega no código; não dá para listar as salas.
    match /salas/{sala}/msgs/{msg} {
      allow read: if sala.size() == 64;
      allow create: if sala.size() == 64
        && request.resource.data.keys().hasOnly(['texto', 'nome', 'em'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 2000
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 30
        && request.resource.data.em == request.time;
      allow update, delete: if false;
    }
  }
}
